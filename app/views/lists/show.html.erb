<%= render "shared/header", title: @list.name, banner: @list.poster_url %>
<div class="container text-dark">
  <div class="d-flex justify-content-between">
    <h2>Bienvene dans la liste de <%= @list.name %></h2>
    <%= link_to "Modifier la liste", edit_list_path(@list), class: "btn btn-info mb-3"  %>
    <%= link_to "Ajouter un film", new_list_bookmark_path(@list), class: "btn btn-primary mb-3"  %>
  </div>
  <div class="movies">
    <% @list.movies.each do |movie| %>
      <div class="movie-card mb-3">
        <%= image_tag movie.poster_url, alt: "#{movie.title} poster" %>
        <div class="movie-card-infos">
          <div>
            <h2><%= movie.title %></h2>
            <p><%= movie.overview %></p>
          </div>
        </div>
        <div class="movie-card-footer">
          <figure>
            <% bookmark = Bookmark.find_by(list: @list, movie: movie) %>
            <figcaption class="blockquote-footer">

              <cite title="Source Title"><%= bookmark.comment %> - <%= link_to "Supprimer",
                bookmark_path, data: {
                    turbo_method: "delete",
                    turbo_confirm: "Ah bon ?"
                    }
              %>
              </cite>
            </figcaption>
          </figure>
          <small>
          </small>
        </div>
      </div>
    <% end %>
  </div>
</div>
